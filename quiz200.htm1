<!DOCTYPE html><html dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>MA1 200</title><style>body{background:#0f172a;color:#fff;font-family:Arial;text-align:center;padding:15px}.card{background:#1e293b;max-width:600px;margin:auto;padding:20px;border-radius:15px}button{width:100%;padding:12px;margin:5px 0;background:#334155;color:#fff;border:0;border-radius:10px;font-weight:bold}button:hover{background:#facc15;color:#000}</style></head><body><h1>🔥 MA1 - 200 سؤال 🔥</h1><div id="p"></div><div id="timer">15</div><div class="card"><div id="q"></div><div id="o"></div><h2 id="s">السكور: 0</h2></div><script>const base=[{q:"سعر النمر؟",a:["3000","2500","3500"],c:0},{q:"فاكهة الزلزال؟",a:["Quake","Flame","Ice"],c:0},{q:"كارتيه القرش من وين؟",a:["Sea2","الثلج","البداية"],c:0},{q:"كم بوس Sea2؟",a:["11","8","20"],c:0},{q:"كيف تجيب توشيتا؟",a:["Torch","30 Elite","2M"],c:0}];let quiz=[];for(let i=0;i<200;i++){let b=base[i%base.length];quiz.push({q:`${i+1}. ${b.q}`,a:b.a,c:b.c})}let i=0,sc=0,time=15;function load(){if(i>=200){q.innerHTML=`خلصت ${sc}/200`;return}p.innerText=`${i+1}/200`;q.innerHTML=quiz[i].q;o.innerHTML=quiz[i].a.map((x,j)=>`<button onclick="check(${j})">${x}</button>`).join('');time=15}function check(j){if(j==quiz[i].c)sc++;s.innerText=`السكور: ${sc}`;i++;load()}load();setInterval(()=>{time--;timer.innerText=time;if(time<=0){i++;load()}},1000)</script></body></html>